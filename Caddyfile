# Abstellraum-Inventar — Caddy-Block fuer den Pi.
#
# ANHAENGEN, NICHT ERSETZEN. Auf dem Pi laeuft Caddy bereits hinter einem
# Cloudflare Tunnel: global auto_https off, gebunden an 127.0.0.1:8080, von
# aussen ausschliesslich ueber den Tunnel erreichbar. Diese Datei ist kein
# vollstaendiger Caddyfile, sondern der Block, der unten an
# /etc/caddy/Caddyfile drangehaengt wird:
#
#   sudo cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak
#   sudo nano /etc/caddy/Caddyfile        # Inhalt ab ":80 {" ans Ende
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Kein Konflikt mit den bestehenden :8080-Bloecken — anderer Port.

:80 {
	# Ausschliesslich aus dem Heimnetz erreichbar. Sollte im Router noch eine
	# alte Portweiterleitung auf 80 stehen, landen Anfragen von aussen hier
	# auf einem 404 statt auf der Kistenliste.
	#
	# remote_ip prueft die echte TCP-Quelladresse, nicht einen Header:
	# X-Forwarded-For laesst sich faelschen, die Verbindung selbst nicht.
	# Deshalb hier bewusst nicht client_ip.
	@heimnetz remote_ip private_ranges

	handle @heimnetz {
		encode gzip

		reverse_proxy 127.0.0.1:8091

		header {
			# Safari haelt Seiten sonst fest; eine veraltete Kistenliste
			# ist schlimmer als eine, die eine Sekunde braucht.
			Cache-Control "no-store"
			-Server
		}
	}

	# Alles andere: nicht einmal zugeben, dass hier etwas liegt.
	handle {
		respond 404
	}
}
